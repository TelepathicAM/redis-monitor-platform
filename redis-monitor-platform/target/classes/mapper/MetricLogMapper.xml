<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN" "http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.danuvius.platform.mapper.MetricLogMapper">

    <!-- 指标日志表结果映射 -->
    <resultMap id="BaseResultMap" type="com.danuvius.platform.model.entity.MetricLog">
        <id     column="id"             property="id"/>
        <result column="executor_id"       property="executorId"/>
        <result column="instance_id"    property="instanceId"/>
        <result column="tm"             property="tm"/>
        <result column="cpu_per"        property="cpuPer"/>
        <result column="mem_server_per" property="memServerPer"/>
        <result column="mem_us"         property="memUs"/>
        <result column="cmd_latency"    property="latency"/>
        <result column="io_iik"         property="ioIik"/>
        <result column="io_iok"         property="ioIok"/>
        <result column="ops"            property="ops"/>
        <result column="role"           property="role"/>
        <result column="redis_version"  property="redisVersion"/>
        <result column="run_id"         property="runId"/>
        <result column="master_host"    property="masterHost"/>
        <result column="master_port"    property="masterPort"/>
        <result column="repl_delay"     property="replDelay"/>
        <result column="collect_type"   property="collectType"/>
        <result column="created_time"   property="createdTime"/>
        <result column="updated_time"   property="updatedTime"/>
    </resultMap>

    <!-- 通用查询列 -->
    <sql id="Base_Column_List">
        id, executor_id, instance_id, tm, cpu_per, mem_server_per, mem_us, cmd_latency,
        io_iik, io_iok, ops, role, redis_version, run_id, master_host, master_port,
        repl_delay, collect_type, created_time, updated_time
    </sql>


    <select id="selectLatestByExecutorId" resultMap="BaseResultMap">
        SELECT <include refid="Base_Column_List"/>
        FROM rms_metric_log
        WHERE executor_id = #{executorId}
        ORDER BY tm DESC
        LIMIT 1
    </select>

    <delete id="deleteExpiredBefore">
        DELETE FROM rms_metric_log WHERE tm &lt; #{threshold}
    </delete>

</mapper>