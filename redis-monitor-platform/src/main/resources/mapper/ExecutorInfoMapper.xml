<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN" "http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.danuvius.platform.mapper.ExecutorInfoMapper">

    <resultMap id="BaseResultMap" type="com.danuvius.platform.model.entity.ExecutorInfo">
        <id     column="id"                  property="id"/>
        <result column="executor_id"         property="executorId"/>
        <result column="instance_id"         property="instanceId"/>
        <result column="host_ip"             property="hostIp"/>
        <result column="executor_port"       property="executorPort"/>
        <result column="executor_token"      property="executorToken"/>
        <result column="executor_status"     property="executorStatus"/>
        <result column="management_status"   property="managementStatus"/>
        <result column="last_heartbeat_time" property="lastHeartbeatTime"/>
        <result column="last_report_time"    property="lastReportTime"/>
        <result column="created_time"        property="createdTime"/>
        <result column="updated_time"        property="updatedTime"/>
    </resultMap>

    <sql id="Base_Column_List">
        id, executor_id,instance_id, host_ip, executor_port, executor_token,
        executor_status, management_status, last_heartbeat_time, last_report_time,
        created_time, updated_time
    </sql>

    <select id="selectByHostIpAndPort" resultMap="BaseResultMap">
        SELECT <include refid="Base_Column_List"/>
        FROM executor_info
        WHERE host_ip = #{hostIp} AND executor_port = #{executorPort}
        LIMIT 1
    </select>

    <select id="selectByToken" resultMap="BaseResultMap">
        SELECT <include refid="Base_Column_List"/>
        FROM executor_info
        WHERE executor_token = #{executorToken}
        LIMIT 1
    </select>
    <select id="selectByInstanceId" resultMap="BaseResultMap">
        SELECT <include refid="Base_Column_List"/>
        FROM executor_info
        WHERE instance_id = #{instanceId}
        LIMIT 1
    </select>

    <select id="selectActiveOnlineExecutors" resultMap="BaseResultMap">
        SELECT <include refid="Base_Column_List"/>
        FROM executor_info
        WHERE management_status = #{managementStatus}
        AND executor_status = #{executorStatus}
    </select>

</mapper>