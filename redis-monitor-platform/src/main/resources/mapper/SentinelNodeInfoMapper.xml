<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN" "http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.danuvius.platform.mapper.SentinelNodeInfoMapper">

    <resultMap id="BaseResultMap" type="com.danuvius.platform.model.entity.SentinelNodeInfo">
        <id     column="id"                  property="id"/>
        <result column="node_name"           property="nodeName"/>
        <result column="node_ip"             property="nodeIp"/>
        <result column="node_port"           property="nodePort"/>
        <result column="sentinel_status"     property="sentinelStatus"/>
        <result column="management_status"   property="managementStatus"/>
        <result column="last_heartbeat_time" property="lastHeartbeatTime"/>
        <result column="created_time"        property="createdTime"/>
        <result column="updated_time"        property="updatedTime"/>
    </resultMap>


    <!--查Sentinel节点列表，managementStatus为空查全部 -->
    <select id="selectSentinelList" resultMap="BaseResultMap">
        SELECT
        id, node_name, node_ip, node_port, sentinel_status,
        management_status, last_heartbeat_time, created_time, updated_time
        FROM sentinel_node_info
        <where>
            <if test="managementStatus != null and managementStatus != ''">
                AND management_status = #{managementStatus}
            </if>
        </where>
        ORDER BY node_name ASC
    </select>

</mapper>