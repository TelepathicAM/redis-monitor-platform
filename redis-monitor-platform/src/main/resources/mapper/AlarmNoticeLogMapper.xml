<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN" "http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.danuvius.platform.mapper.AlarmNoticeLogMapper">

    <resultMap id="BaseResultMap" type="com.danuvius.platform.model.entity.AlarmNoticeLog">
        <id     column="id"             property="id"/>
        <result column="alarm_record_id" property="alarmRecordId"/>
        <result column="alarm_no"       property="alarmNo"/>
        <result column="notice_type"    property="noticeType"/>
        <result column="receiver"       property="receiver"/>
        <result column="send_time"      property="sendTime"/>
        <result column="send_status"    property="sendStatus"/>
        <result column="fail_reason"    property="failReason"/>
        <result column="created_time"   property="createdTime"/>
    </resultMap>

    <sql id="Base_Column_List">
        id, alarm_record_id, alarm_no, notice_type, receiver,
        send_time, send_status, fail_reason, created_time
    </sql>

    <select id="selectByAlarmRecordId" resultMap="BaseResultMap">
        SELECT <include refid="Base_Column_List"/>
        FROM alarm_notice_log
        WHERE alarm_record_id = #{alarmRecordId}
        ORDER BY send_time DESC
    </select>

</mapper>
